# Firebase Web SDK (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only, never expose to client)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# AI API (server-only) - Google Gemini API key from aistudio.google.com/apikey
AI_API_KEY=

# Vercel Blob (server-only, meal/InBody photo storage)
BLOB_READ_WRITE_TOKEN=

# Notion API (server-only)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
